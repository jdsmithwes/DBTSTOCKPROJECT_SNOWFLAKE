# ── Snowflake connection (required for both targets) ───────────────────────────
SNOWFLAKE_ACCOUNT=<your-account-identifier>        # e.g. TPRFGUJ-JNC76647
SNOWFLAKE_USER=<your-snowflake-username>
SNOWFLAKE_ROLE=DBT_ROLE
SNOWFLAKE_DATABASE=DBT_STOCKPROJECT
SNOWFLAKE_WAREHOUSE=DBT_STOCKPROJECT
SNOWFLAKE_SCHEMA=DBT_DEV_JDS_STAGING

# ── Auth: local development — key-pair (target = dev / prod) ──────────────────
# Path to the RSA private key file generated for Snowflake key-pair auth.
# Generate: openssl genrsa -out ~/.ssh/snowflake_rsa_key.p8 2048
# Register public key: ALTER USER <user> SET RSA_PUBLIC_KEY='<contents of .pub>';
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/<you>/.ssh/snowflake_rsa_key.p8

# ── Auth: inside Snowflake Workspace / Tasks (target = snowflake) ─────────────
# No password or key needed — Snowflake injects session credentials automatically.
# The 'snowflake' target in profiles.yml has no auth fields; leave this section empty.

# ── dbt target override ────────────────────────────────────────────────────────
# Omit (or set to 'dev') for local runs. Set to 'snowflake' for Snowflake-internal runs.
# DBT_TARGET=dev

# ── API keys ───────────────────────────────────────────────────────────────────
FRED_API_KEY=<your-fred-api-key>
ALPHAVANTAGE_API_KEY=<your-alphavantage-api-key>
