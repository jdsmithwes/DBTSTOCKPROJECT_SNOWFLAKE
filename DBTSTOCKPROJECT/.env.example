# ── Snowflake connection (required for both targets) ───────────────────────────
SNOWFLAKE_ACCOUNT=<your-account-identifier>        # e.g. TPRFGUJ-JNC76647
SNOWFLAKE_USER=<your-snowflake-username>
SNOWFLAKE_ROLE=DBT_ROLE
SNOWFLAKE_DATABASE=DBT_STOCKPROJECT
SNOWFLAKE_WAREHOUSE=DBT_STOCKPROJECT
SNOWFLAKE_SCHEMA=DBT_DEV_JDS_STAGING

# ── Auth: local development (target = dev) ─────────────────────────────────────
SNOWFLAKE_PASSWORD=<your-snowflake-password>

# ── Auth: inside Snowflake / OAuth (target = snowflake) ───────────────────────
# Set DBT_TARGET=snowflake and supply the OAuth token injected by Snowflake.
# Leave blank or unset when running locally.
# DBT_TARGET=snowflake
# SNOWFLAKE_TOKEN=<oauth-token-injected-by-snowflake>

# ── dbt target override ────────────────────────────────────────────────────────
# Omit (or set to 'dev') for local runs. Set to 'snowflake' for Snowflake-internal runs.
# DBT_TARGET=dev

# ── API keys ───────────────────────────────────────────────────────────────────
FRED_API_KEY=<your-fred-api-key>
ALPHAVANTAGE_API_KEY=<your-alphavantage-api-key>
